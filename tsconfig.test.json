{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": false,
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
